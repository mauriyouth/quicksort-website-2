VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Magic design (server only; never prefix secrets with VITE_)
# Admin Magic design reuses Settings > AI configuration, or OPENAI_API_KEY.

# Server-only research connection. Never expose these with a VITE_ prefix.
TREG_TOKEN=your-server-token
TREG_ORG=quicksort
TREG_ENRICHMENT_LIMIT=300
# Required for server-only usage recording (never use a VITE_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
# Numeric Treg organization ID used by the usage ledger API.
TREG_ORG_ID=your-org-id
# Optional organization admin token for reporting if TREG_TOKEN cannot read usage.
TREG_REPORT_TOKEN=

# Daily Qonto transactions sync (Vercel cron sends it as a Bearer token). Generate with: openssl rand -hex 32
CRON_SECRET=
# Kimi (Moonshot) fallback key for bank transaction classification; normally set in Settings.
MOONSHOT_API_KEY=

# Admin impersonation (Accounts > Impersonate a user) mints Clerk actor tokens. Server only.
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
