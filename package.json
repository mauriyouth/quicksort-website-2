{
  "name": "quicksort-os",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev:admin": "pnpm --filter @quicksort/admin dev",
    "dev": "pnpm --filter @quicksort/admin dev",
    "dev:candidate": "pnpm --filter @quicksort/candidate dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:hr-db": "node scripts/verify-hr-database.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.58.2",
    "supabase": "2.116.0",
    "typescript": "5.9.3"
  }
}
